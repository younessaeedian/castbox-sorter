{
  "manifest_version": 3,
  "name": "Castbox Sorter",
  "version": "3.0",
  "description": "Sorts all episodes on a channel page by likes, plays, comments or date using the Castbox API.",
  "minimum_chrome_version": "111",

  "host_permissions": ["https://*.castbox.fm/*"],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://castbox.fm/*", "https://www.castbox.fm/*"],
      "js": ["src/content.js"],
      "css": ["src/style.css"]
    },
    {
      "matches": ["https://castbox.fm/*", "https://www.castbox.fm/*"],
      "js": ["src/page.js"],
      "world": "MAIN"
    }
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
